# Copy this file to .env and fill in real values.
# Never commit the real .env — it's already gitignored.

# ------------------------------------------------------------
# Salesforce (connected app, client_credentials flow)
# ------------------------------------------------------------
SF_LOGIN_URL=https://your-instance.my.salesforce.com
SF_CLIENT_ID=your-connected-app-consumer-key
SF_CLIENT_SECRET=your-connected-app-consumer-secret

# Currently unused by the app itself, kept for reference/future use
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
# The deployed frontend's origin, e.g. https://your-app.vercel.app
FRONTEND_URL=

# ------------------------------------------------------------
# App login (JWT)
# ------------------------------------------------------------
# A long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Minutes before a login token expires (optional, defaults to 480 = 8h)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# JSON array of app login accounts: [{"username": "...", "password_hash": "...", "role": "..."}]
# "role" must match one of the roles in frontend/src/config/rolePermissions.js
# (ADMIN, SALES_MANAGER, FIELD_USER).
# Generate a password_hash with:
#   python backend/scripts/make_user.py <username> <password> <role>
APP_USERS=[]

# ------------------------------------------------------------
# Routing (GIS Map "Generate Route")
# ------------------------------------------------------------
# Free API key from https://openrouteservice.org/dev/#/signup - used to
# turn a rep's pending stops into a real optimized, road-following route
# (distance/ETA/turn-by-turn geometry), replacing straight-line estimates.
ORS_API_KEY=
